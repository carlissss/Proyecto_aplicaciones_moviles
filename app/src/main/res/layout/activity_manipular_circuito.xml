<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_3"
    android:orientation="vertical"
    tools:context=".Manipular_circuito">

    <TextView
        android:id="@+id/tv5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="20dp"
        android:background="#63D5D4D5"
        android:text="Nombre Usuario"
        android:textAlignment="center"
        android:textColor="#290A64"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:background="#63D5D4D5"
        android:text="Manipular Circuito"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="39sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="120dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="120dp"
        android:layout_marginBottom="10dp"
        android:height="150dp"
        android:background="@android:drawable/presence_invisible"
        android:backgroundTint="#404040"
        android:backgroundTintMode="multiply"
        android:fallbackLineSpacing="true"
        android:hapticFeedbackEnabled="true"
        android:text="Activar"
        android:textColor="@color/white"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btn11"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="120dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="120dp"
        android:height="150dp"
        android:background="@android:drawable/presence_invisible"
        android:backgroundTint="#404040"
        android:text="Desactivar"
        android:textColor="@color/white"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btn12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="0"
        android:height="60dp"
        android:backgroundTint="#8F000000"
        android:text="Volver"
        android:textColor="@color/white"
        android:textSize="18sp" />
</LinearLayout>