<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_3"
    tools:context=".Crear_cuenta"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="20dp"
        android:background="#63D5D4D5"
        android:text="Crear Cuenta"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="48sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/txt3"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        android:background="@color/black"
        android:backgroundTint="@color/material_dynamic_neutral95"
        android:ems="10"
        android:hint="Rut"
        android:inputType="text"
        android:textAlignment="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/txt5"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="20dp"
            android:layout_weight="1"
            android:background="@color/black"
            android:backgroundTint="@color/material_dynamic_neutral95"
            android:ems="10"
            android:hint="Nombre"
            android:inputType="text"
            android:textAlignment="center" />

        <EditText
            android:id="@+id/txt6"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="20dp"
            android:layout_weight="1"
            android:background="@color/black"
            android:backgroundTint="@color/material_dynamic_neutral95"
            android:ems="10"
            android:hint="Apellido"
            android:inputType="text"
            android:textAlignment="center" />
    </LinearLayout>

    <EditText
        android:id="@+id/txt20"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        android:background="@color/black"
        android:backgroundTint="@color/material_dynamic_neutral95"
        android:ems="10"
        android:hint="Correo Electronico"
        android:inputType="text"
        android:textAlignment="center" />

    <Spinner
        android:id="@+id/spinner_cargo"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        android:background="@android:drawable/btn_dropdown"
        android:backgroundTint="@color/material_dynamic_neutral95"
        android:backgroundTintMode="src_atop"
        android:entries="@array/listaopciones"
        android:textAlignment="center" />

    <EditText
        android:id="@+id/txt9"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        android:background="@color/black"
        android:backgroundTint="@color/material_dynamic_neutral95"
        android:ems="10"
        android:hint="Contraseña"
        android:inputType="numberPassword"
        android:textAlignment="center" />

    <EditText
        android:id="@+id/txt10"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        android:background="@color/black"
        android:backgroundTint="@color/material_dynamic_neutral95"
        android:ems="10"
        android:hint="Repetir Contraseña"
        android:inputType="numberPassword"
        android:textAlignment="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:height="60dp"
            android:backgroundTint="#8F000000"
            android:text="Registrar"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:height="60dp"
            android:backgroundTint="#9DD3D1D3"
            android:text="Volver"
            android:textColor="@color/black"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>